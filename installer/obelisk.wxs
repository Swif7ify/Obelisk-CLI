<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- Product Definition -->
  <Product Id="*" 
           Name="Obelisk CLI" 
           Language="1033" 
           Version="$(var.Version)" 
           Manufacturer="OneDev PH" 
           UpgradeCode="4c2c5fcb-75f7-4c12-8dbf-2d5c150021e4">
    
    <!-- Package Information -->
    <Package InstallerVersion="200" 
             Compressed="yes" 
             InstallScope="perMachine" 
             Description="Obelisk CLI - AI-Powered Automated Tech Lead"
             Comments="Built with IBM Bob IDE for the IBM Bob Hackathon 2026"
             Manufacturer="OneDev PH" />

    <!-- Media Definition -->
    <Media Id="1" Cabinet="obelisk.cab" EmbedCab="yes" />

    <!-- Upgrade Logic -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <!-- Installation Directory Structure -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <!-- Program Files -->
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Obelisk CLI">
          <Component Id="ObeliskExecutable" Guid="f0ef31b2-ef9f-4250-8ff4-27280f9ab9bb" Win64="yes">
            <!-- Main Executable -->
            <File Id="ObeliskExe" 
                  Source="$(var.BinDir)\obelisk.exe" 
                  KeyPath="yes" 
                  Checksum="yes" />
            
            <!-- Add to PATH -->
            <Environment Id="PATH" 
                         Name="PATH" 
                         Value="[INSTALLFOLDER]" 
                         Permanent="no" 
                         Part="last" 
                         Action="set" 
                         System="yes" />
          </Component>

          <!-- Documentation -->
          <Component Id="Documentation" Guid="007251e1-cd63-495e-9d0d-6da74ac8f62f" Win64="yes">
            <File Id="ReadmeFile" Source="$(var.ProjectDir)\README.md" KeyPath="yes" />
            <File Id="LicenseFile" Source="$(var.ProjectDir)\LICENSE" />
            <File Id="ChangelogFile" Source="$(var.ProjectDir)\CHANGELOG.md" />
          </Component>
        </Directory>
      </Directory>

      <!-- Start Menu Shortcuts -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Obelisk CLI">
          <Component Id="ApplicationShortcut" Guid="a3b7e916-8c4d-4f1a-b2d8-9e6f3a5c7d01">
            <Shortcut Id="UninstallProduct"
                      Name="Uninstall Obelisk CLI"
                      Description="Uninstalls Obelisk CLI"
                      Target="[SystemFolder]msiexec.exe"
                      Arguments="/x [ProductCode]" />
            <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
            <RegistryValue Root="HKCU" 
                          Key="Software\OneDev\Obelisk" 
                          Name="installed" 
                          Type="integer" 
                          Value="1" 
                          KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <!--
      Custom Action: Prompt user during uninstall with a native Windows dialog.
      This is an inline VBScript that runs IMMEDIATELY (before deferred actions),
      so it can show a UI popup even when uninstalling from Add/Remove Programs.
      It directly deletes ~/.obelisk and removes the keyring entry if user says Yes.
    -->
    <CustomAction Id="PromptAndCleanupUserData" Script="vbscript" Execute="immediate" Return="ignore">
      <![CDATA[
        Dim shell, fso, userProfile, configDir, result

        Set shell = CreateObject("WScript.Shell")
        Set fso   = CreateObject("Scripting.FileSystemObject")

        userProfile = shell.ExpandEnvironmentStrings("%USERPROFILE%")
        configDir   = userProfile & "\.obelisk"

        ' Only prompt if user data actually exists
        If fso.FolderExists(configDir) Then
          result = MsgBox( _
            "Obelisk found user data at:" & vbCrLf & _
            configDir & vbCrLf & vbCrLf & _
            "This includes your configuration and saved API keys." & vbCrLf & vbCrLf & _
            "Do you want to DELETE all user data?" & vbCrLf & _
            "(Click No to keep your settings for a future reinstall)", _
            vbYesNo + vbQuestion + vbDefaultButton2, _
            "Obelisk CLI - Uninstall Cleanup")

          If result = vbYes Then
            ' Delete the config directory
            fso.DeleteFolder configDir, True

            ' Remove stored API key from Windows Credential Manager
            shell.Run "cmdkey /delete:obelisk-cli", 0, True
          End If
        End If

        Set fso   = Nothing
        Set shell = Nothing
      ]]>
    </CustomAction>

    <InstallExecuteSequence>
      <!-- Show the cleanup prompt only during a full uninstall, before files are removed -->
      <Custom Action="PromptAndCleanupUserData" Before="RemoveFiles">
        REMOVE="ALL"
      </Custom>
    </InstallExecuteSequence>

    <!-- Features -->
    <Feature Id="ProductFeature" 
             Title="Obelisk CLI" 
             Level="1"
             Description="The complete Obelisk CLI installation including the executable and documentation.">
      <ComponentRef Id="ObeliskExecutable" />
      <ComponentRef Id="Documentation" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <!-- User Interface -->
    <UIRef Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- License Agreement -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.ProjectDir)\installer\License.rtf" />

    <!-- Properties -->
    <Property Id="ARPHELPLINK" Value="https://github.com/Swif7ify/Obelisk-CLI" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Swif7ify/Obelisk-CLI" />
    <Property Id="ARPNOREPAIR" Value="yes" Secure="yes" />

    <Icon Id="ObeliskIcon" SourceFile="$(var.ProjectDir)\installer\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="ObeliskIcon" />

  </Product>
</Wix>
